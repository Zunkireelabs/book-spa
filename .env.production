# Feature flags baked into the production Docker image (deploy.yml,
# BUILD_MODE=production, Vite's default mode). Vite loads this file
# automatically during `vite build --mode production` (see Dockerfile) —
# no other file needs editing to add or remove a production flag. Real
# secrets (Supabase URL/key, PostHog) are NOT here — those stay in GitHub
# Environment secrets and are passed as Docker build-args, since they must
# never be committed.
#
# A flag only belongs here once its schema/feature has been verified on
# staging (.env.staging) and is ready to promote.

VITE_ENABLE_MEMBERSHIP=true
VITE_ENABLE_VOUCHERS=true
VITE_ENABLE_CUSTOMER_REFERRALS=false
