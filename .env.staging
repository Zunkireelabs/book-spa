# Feature flags baked into the staging Docker image (deploy-staging.yml,
# BUILD_MODE=staging). Vite loads this file automatically during
# `vite build --mode staging` (see Dockerfile) — no other file needs
# editing to add or remove a staging flag. Real secrets (Supabase URL/key,
# PostHog) are NOT here — those stay in GitHub Environment secrets and are
# passed as Docker build-args, since they must never be committed.
#
# To promote a flag to production once its schema/feature is verified on
# staging, move (don't copy) its line into .env.production.

VITE_ENABLE_MEMBERSHIP=true
VITE_ENABLE_VOUCHERS=true
VITE_ENABLE_CUSTOMER_REFERRALS=true
VITE_ENABLE_OUTREACH=true
VITE_ENABLE_PLATFORM_ADMIN=true
VITE_ENABLE_PRODUCTS=true
VITE_ENABLE_CAMPAIGNS=true
